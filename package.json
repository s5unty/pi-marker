{
  "name": "pi-marker",
  "version": "0.2.2",
  "private": true,
  "description": "Persistent mouse highlighter with Markdown file and clipboard export for Pi",
  "type": "module",
  "keywords": ["pi-package"],
  "engines": { "node": ">=22.18.0" },
  "pi": { "extensions": ["./src/index.ts"] },
  "files": ["src", "README.md"],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "test:cli": "python3 test/cli-smoke.py",
    "check": "tsc --noEmit",
    "demo": "node scripts/demo.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
